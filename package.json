{
  "name": "cyberpunk-tcg-trainer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Night City Trainer: an unofficial Cyberpunk TCG practice site (static, no server): play vs bots with a coach, saved and multi-day games, play online, game review, deck builder and Deck Lab, meta and guides, bot-vs-bot tournaments and ratings.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsx tools/check-index-access.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage --coverage.include=src",
    "build:data": "tsx tools/build-data.ts",
    "sim": "tsx scripts/simulate.ts",
    "tournament": "tsx scripts/tournament.ts",
    "bundle-reports": "tsx scripts/bundle-reports.ts",
    "refresh": "tsx scripts/bundle-reports.ts && tsx scripts/plan.ts && tsx scripts/build-h2h.ts",
    "build-h2h": "tsx scripts/build-h2h.ts",
    "check:data": "tsx scripts/check-data.ts",
    "kb": "tsx scripts/kb.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
