  //   tsconfig.worker.json  the browser workers (src/sim/*.worker.ts, WebWorker) and everything they import
  //   tsconfig.node.json    scripts/, tools/ and vite.config.ts (Node, no DOM)
  //   tsconfig.test.json    tests/ (Node and DOM: component tests run in jsdom)
  // Shared compiler options are in tsconfig.base.json.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.worker.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.test.json" }
  ]
}
